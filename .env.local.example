# ============================================================================
# JNPA UC-III PoC — local environment
# Copy this file to `.env.local` and fill in the API keys before `make up`.
#   cp .env.local.example .env.local
# Everything internal uses Etc/UTC; convert to Asia/Kolkata only at the
# dashboard layer.
# ============================================================================

# --- Postgres ---------------------------------------------------------------
# DEFAULT (and what the deployed stack uses): AWS RDS, database jnpa_schema_v3.
# There is NO local-postgres fallback anywhere — compose requires these vars
# (${VAR:?…}) and the Python config defaults are empty, so a missing DSN fails
# loudly instead of quietly connecting to a container database.
#
# SECURITY (see docs/RDS_SECURITY.md — read it before filling these in):
#   * __RDS_HOST__ / __RDS_USER__ / __RDS_PASSWORD__ are PLACEHOLDERS. The real
#     endpoint is deliberately NOT committed: publishing it turns a password
#     guess into a direct path to ~31.8k driving licences.
#   * __RDS_USER__ must NOT be the `postgres` superuser. Create the least-
#     privilege application role `jnpa_app` first — docs/RDS_SECURITY.md §3.
#   * The RDS security group must NOT be open to 0.0.0.0/0 — §2.
#
# asyncpg needs `ssl=require`; libpq/psycopg need `sslmode=require`.
POSTGRES_PASSWORD=__RDS_PASSWORD__
POSTGRES_DSN=postgresql+asyncpg://__RDS_USER__:__RDS_PASSWORD__@__RDS_HOST__:5432/jnpa_schema_v3?ssl=require
RFID_POSTGRES_DSN=postgresql://__RDS_USER__:__RDS_PASSWORD__@__RDS_HOST__:5432/jnpa_schema_v3?sslmode=require
TRUCK_POSTGRES_DSN=postgresql://__RDS_USER__:__RDS_PASSWORD__@__RDS_HOST__:5432/jnpa_schema_v3?sslmode=require
CONGESTION_POSTGRES_DSN=postgresql://__RDS_USER__:__RDS_PASSWORD__@__RDS_HOST__:5432/jnpa_schema_v3?sslmode=require
ANOMALY_POSTGRES_DSN=postgresql://__RDS_USER__:__RDS_PASSWORD__@__RDS_HOST__:5432/jnpa_schema_v3?sslmode=require

# OPTIONAL local sandbox DB (developer laptops only). Start it explicitly with
#   docker compose --profile localdb up -d postgres
# and point the five DSNs above at it; nothing does this for you.
#   POSTGRES_PASSWORD=jnpa_pw
#   POSTGRES_DSN=postgresql+asyncpg://postgres:jnpa_pw@postgres:5432/postgres  # localhost:5433 from the host

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Determinism / demo mode ------------------------------------------------
# Single global seed for the whole simulated twin. Every simulator derives its
# own stream seed from this (jnpa_shared.config.derive_seed), so a recorded
# runbook replays byte-identically under the same SEED.
SEED=1337
# DATA_MODE: "mock" = offline-first, no external network; "live" = connectors
# may reach external APIs when keys are present. Frontend reads VITE_DATA_MODE.
DATA_MODE=mock
# OFFLINE=true forbids any network egress from simulators even if keys exist
# (used by the network-disabled acceptance run). Implies DATA_MODE=mock.
OFFLINE=false
# DRY_RUN (anpr-ingest): true = synthetic plate crops, no AI OCR call — the
# offline-friendly local default. The service DEFAULTS to false (real OCR) and
# REFUSES to start with DRY_RUN=true in any non-development APP_ENV, so this line
# only matters for the local demo.
DRY_RUN=true
# Wrap backbone events in a CloudEvents 1.0 envelope tagged sourcesystem=SIM/LIVE
# with a rawref pointer. Consumers auto-unwrap, so this is safe to leave on.
CLOUDEVENTS_ENABLED=true

# --- Kafka ------------------------------------------------------------------
# Internal listener (service name). From the host use localhost:29092.
KAFKA_BROKERS=kafka:9092

# --- MQTT (Mosquitto) -------------------------------------------------------
MQTT_BROKER=mosquitto:1883

# --- MinIO (model artefacts + ANPR snapshots) -------------------------------
# Required (compose fails fast if unset). The demo defaults below are fine for a
# local laptop run; override with strong values before any shared/prod deploy.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Grafana admin (SEC-4: no hard-coded creds in compose) ------------------
# GF_SECURITY_ADMIN_PASSWORD has NO default — compose refuses to start unset.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- Grafana Postgres datasource --------------------------------------------
# REQUIRED. GRAFANA_PG_HOST is ${GRAFANA_PG_HOST:?} in docker-compose.yml, and
# compose interpolates EVERY service before starting ANY of them — an unset
# value here aborts `make up` for the whole stack, not just Grafana.
# Same RDS instance as the DSNs above, as host:PORT.
GRAFANA_PG_HOST=__RDS_HOST__:5432
GRAFANA_PG_DB=jnpa_schema_v3
GRAFANA_PG_USER=__RDS_USER__
GRAFANA_PG_SSLMODE=require
# Password comes from POSTGRES_PASSWORD above; there is no GRAFANA_PG_PASSWORD.

# --- Gateway auth + RBAC (Wave 3 / SEC-1, SEC-2) ----------------------------
# ON by default. This used to ship `false` "for a frictionless demo", which meant
# the demo build served the whole driver registry — ~31.8k real licence numbers
# and dates of birth — to anyone who could reach the port. Enforcement is now the
# default posture and turning it off is the deliberate act.
#
# APP_ENV gates the startup security checks. `development` is the ONLY value that
# allows AUTH_ENABLED=false and the /api/auth/dev-token seam. Any other value
# (staging/production) makes the gateway refuse to start unless auth is hardened.
APP_ENV=development
AUTH_ENABLED=true
# REQUIRED when AUTH_ENABLED=true — the gateway refuses to start on the old
# well-known default. Generate one:  openssl rand -hex 32
# `make env-init` fills this automatically.
AUTH_JWT_SECRET=__GENERATE_ME__
AUTH_RATE_LIMIT_PER_MIN=600
# Password-less token seam. Fine in development (APP_ENV=development); the
# startup guard forces this to false in any production-like environment.
AUTH_DEV_TOKENS=true
# Comma-separated allowed browser origins; empty => "*" (dev only).
CORS_ALLOW_ORIGINS=
# Web build: shows the login gate + role-filtered nav. Must MATCH AUTH_ENABLED,
# otherwise the dashboard sends no bearer token and every call 401s.
VITE_AUTH_ENABLED=true

# --- PII masking (DPDP) -----------------------------------------------------
# core.driver holds ~31.8k real licence numbers + dates of birth; core.transporter
# holds ~2.2k contact emails/mobiles/addresses. Responses are masked unless the
# caller's role is listed here. Masking is opt-OUT and fails CLOSED: with no
# principal (AUTH_ENABLED=false) everything is masked. See gateway/pii.py.
PII_MASKING_ENABLED=true
PII_UNMASK_ROLES=DTCCC_ADMIN,CUSTOMS
# PWA login eligibility gate. When true, POST /api/auth/device-token only mints a
# DRIVER token if the entered Vehicle ID is assigned to an ACTIVE driver
# (driver_enrollments -> drivers), else 403. Off for the local/demo profile so any
# well-formed TRK-###### can pair; set true to exercise the assignment gate.
REQUIRE_DRIVER_PROFILE=false

# --- External map / traffic / weather APIs ----------------------------------
# Google Maps Platform key — https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=
# HERE Maps freemium key — https://platform.here.com/
HERE_API_KEY=
# TomTom developer key — https://developer.tomtom.com/
TOMTOM_API_KEY=
# OpenWeather One Call key — https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Open-Meteo Weather + Marine (/api/weather) -----------------------------
# Public API, no API key required. The values below are the official public
# endpoints — also the built-in defaults (integrations/openmeteo/client.py), so
# leaving these unset works too; override only to route through a proxy or a
# self-hosted Open-Meteo instance.
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# HTTP timeout per attempt in seconds
OPEN_METEO_TIMEOUT_S=5
# Retry count for timeout/network/5xx failures
OPEN_METEO_RETRIES=2

# --- OpenWeatherMap (/api/weather "openweather" block) ----------------------
# Uses OPENWEATHER_API_KEY above (https://openweathermap.org/api — free tier is
# enough). BACKEND-ONLY: the key is read by the gateway and sent only to
# api.openweathermap.org; it is never exposed as a VITE_ variable or called
# from the browser. Empty key -> the openweather block is disabled and
# /api/weather keeps serving Open-Meteo exactly as before.
# URL empty/unset -> the official endpoint (built-in default); override only
# to route through a proxy.
OPENWEATHER_URL=https://api.openweathermap.org/data/2.5/weather
# HTTP timeout per attempt in seconds
OPENWEATHER_TIMEOUT_S=5

# --- WorldTides (/api/weather "tide" block) ---------------------------------
# https://www.worldtides.info/developer — pay-per-call credits (~USD 10 covers
# a PoC many times over). BACKEND-ONLY: the key is read by the gateway and
# sent only to worldtides.info; never a VITE_ variable, never called from the
# browser. Empty key -> the tide block still serves from the keyless rungs
# (Open-Meteo marine sea level -> cached -> analytic model, clearly tagged).
WORLDTIDES_API_KEY=
# URL empty/unset -> the official v3 endpoint (built-in default).
WORLDTIDES_BASE_URL=
# HTTP timeout per attempt in seconds
WORLDTIDES_TIMEOUT_S=5
# Retry count for timeout/network/5xx failures
WORLDTIDES_RETRIES=2
# Retry count for timeout/network/5xx failures (4xx incl. 401/429 fail fast)
OPENWEATHER_RETRIES=2

# --- TomTom Traffic (/api/traffic/current) ----------------------------------
# Uses TOMTOM_API_KEY above (https://developer.tomtom.com/ — free tier is
# enough). BACKEND-ONLY: the key is read by the gateway and sent only to
# api.tomtom.com; it is never exposed as a VITE_ variable or called from the
# browser. Empty key -> the LIVE rung is disabled and /api/traffic/current
# degrades through CACHED (Redis) -> DATABASE -> SYNTHETIC.
# URLs empty/unset -> the official endpoints (built-in defaults); override
# only to route through a proxy.
TOMTOM_FLOW_URL=https://api.tomtom.com/traffic/services/4/flowSegmentData/absolute/10/json
TOMTOM_INCIDENTS_URL=https://api.tomtom.com/traffic/services/5/incidentDetails
# HTTP timeout per attempt in seconds
TOMTOM_TIMEOUT_S=5
# Retry count for timeout/network/5xx failures (4xx incl. 401/403/429 fail fast)
TOMTOM_RETRIES=2

# --- Bhuvan WMS (ISRO/NRSC geospatial layer, /api/bhuvan) --------------------
# Standard OGC WMS map service — NO API key, NO account. The gateway is
# control-plane only: it validates availability (GetCapabilities) and serves
# the layer configuration to the dashboard; the browser renders the WMS tiles
# directly on the ArcGIS map (Live Operations → Layers → Bhuvan Satellite
# Layer). URL/layer empty/unset -> the built-in defaults below; override only
# to route through a proxy or to publish a different Bhuvan layer.
BHUVAN_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms
BHUVAN_LAYER=india3
# false hides the Bhuvan layer from the frontend without touching code
BHUVAN_ENABLED=true
# HTTP timeout per attempt in seconds
BHUVAN_TIMEOUT_S=5
# Retry count for timeout/network/5xx failures (4xx fail fast)
BHUVAN_RETRIES=2

# --- ULIP Logistics Intelligence (/api/logistics/*) --------------------------
# ULIP (Unified Logistics Interface Platform, DPIIT) account credentials —
# https://www.ulip.dpiit.gov.in/ (registration required). BACKEND-ONLY: read
# by the gateway and sent only to the ULIP platform; never exposed as a VITE_
# variable or called from the browser. Auth: either the login pair below
# (POST /user/login token flow) or the pre-issued static ULIP_API_KEY further
# down. All empty -> the LIVE rung is disabled and /api/logistics/* degrades
# through CACHED (Redis) -> DATABASE -> FALLBACK (explicitly empty — no
# fabricated shipment data).
# URL empty/unset -> the official endpoint (built-in default
# https://www.ulip.dpiit.gov.in/ulip/v1.0.0); override for staging or a proxy.
ULIP_API_URL=
ULIP_CLIENT_ID=
ULIP_CLIENT_SECRET=
# HTTP timeout per attempt in seconds
ULIP_TIMEOUT_S=5
# Retry count for timeout/network/5xx failures (4xx incl. 401/403/429 fail fast)
ULIP_RETRIES=2
# Login-token reuse window in seconds (login mode only)
ULIP_TOKEN_TTL_S=1800
# ULIP API paths (defaults FASTAG/01 and LDB/01 — override per subscription)
ULIP_FASTAG_API=
ULIP_LDB_API=
GATEWAY_CACHE_TTL_ULIP_S=300

# --- Indian Govt / vehicle data APIs ----------------------------------------
# Surepass (Vahan / FASTag / RC lookups) — https://surepass.io/
# Leave blank to keep the live adapter (vahan-live, port 8202) disabled: it
# returns HTTP 503 {"error":"live_disabled"} until a token is set. The
# simulator (vahan-sim, port 8201) needs no key.
SUREPASS_API_TOKEN=
# ULIP (Unified Logistics Interface Platform) — https://www.ulip.dpiit.gov.in/
ULIP_API_KEY=
# --- FASTag ULIP APIs (/api/fastag/*) -------------------------------------
# TO BE CONFIGURED against the authorised FASTag provider spec. Leave blank for
# local/dev: with FASTAG_ULIP_URL empty the client returns a config error (500)
# and never calls a vendor. NOTHING here is hardcoded in code.
#   FASTAG_ULIP_URL           = provider base URL, e.g. https://<provider-host>/api
#   FASTAG_ULIP_*_PATH        = endpoint paths (defaults used if blank — CONFIRM vs spec)
#   FASTAG_ULIP_AUTH_SCHEME   = bearer | apikey | none   (do NOT assume bearer — confirm)
#   FASTAG_ULIP_AUTH_HEADER   = header name when scheme=apikey (e.g. X-API-Key)
# The credential is ULIP_API_KEY above.
FASTAG_ULIP_URL=
FASTAG_ULIP_ENROUTE_PATH=
FASTAG_ULIP_BALANCE_PATH=
FASTAG_ULIP_TRANSACTION_PATH=
FASTAG_ULIP_AUTH_SCHEME=bearer
FASTAG_ULIP_AUTH_HEADER=X-API-Key
FASTAG_ULIP_TIMEOUT_S=10
FASTAG_ULIP_RETRIES=2
# ISRO Bhuvan geo-services — https://bhuvan.nrsc.gov.in/
BHUVAN_API_KEY=

# --- LDB / NLDS (Logistics Data Bank, /api/ldb) ------------------------------
# Base URL for the NLDS LDB v2 API (gateway/routers/ldb.py):
#   POST {LDB_BASE_URL}/truck/search  {"vehiclenumber": "MH43CQ0554"}
# Set => LIVE rung (calls audited to core.integration_lookup); blank => MOCK.
LDB_BASE_URL=https://ldb.co.in/api/ldbv2
# Optional bearer token; the public ldb.co.in endpoint needs none.
LDB_API_KEY=

# --- Vahan simulator / live adapter -----------------------------------------
# Number of deterministic plates the simulator generates (default 25000).
VAHAN_TOTAL_PLATES=25000
# Artificial Parivahan-like latency per lookup (ms): mean +/- jitter.
VAHAN_LATENCY_MEAN_MS=100
VAHAN_LATENCY_JITTER_MS=50

# --- ANPR + OCR inference service (ai/anpr, port 8301) ----------------------
# BUILD PLATFORM. paddlepaddle 2.6 publishes no linux/arm64 wheel and
# ai/anpr/Dockerfile tolerates the failed install, so an image built on Apple
# Silicon ships WITHOUT a plate-text recogniser and reports 0.0 accuracy — a real
# measurement of the fallback, not of the bid stack. On arm64, set this to
# linux/amd64 (Rosetta: slower to build, but the real engine loads) or run the
# ANPR service on an x86_64 host. Leave empty on an amd64 machine.
#   Verify which engine is live:  curl :8301/eval | jq .capability
ANPR_PLATFORM=
# YOLO detector confidence threshold.
ANPR_DETECT_CONF=0.25
# Held-out benchmark size (plates) and the combined-accuracy target for /eval.
ANPR_EVAL_SIZE=200
ANPR_EVAL_TARGET_PCT=95.0
# Expected SHA-256 of the YOLO plate weights; when set, startup hash-verifies
# the weights file and refuses to load on mismatch. Blank = check skipped.
ANPR_YOLO_SHA256=
# MinIO bucket the service persists/loads YOLO weights from.
ANPR_MODEL_BUCKET=models

# --- Congestion forecaster (ai/congestion, port 8311) -----------------------
# Days of synthetic bootstrap history + training epochs (first-boot training).
CONGESTION_HISTORY_DAYS=14
CONGESTION_EPOCHS=50
# Bid target gates; train.py exits non-zero if the held-out metrics miss these.
CONGESTION_TARGET_F1=0.85
CONGESTION_TARGET_PRECISION=0.80
CONGESTION_TARGET_RECALL=0.80
# Kafka topic the per-minute prediction scheduler publishes to.
CONGESTION_PREDICTIONS_TOPIC=traffic.predictions
CONGESTION_PUBLISH_INTERVAL_S=60

# --- Behavioural anomaly detector (ai/anomaly, port 8321) -------------------
# Hybrid: ByteTrack + rule engine + trajectory autoencoder. Consumes the shared
# Redis frame bus (frames.{camera_id}) + Kafka truck.telemetry; writes alerts to
# jnpa.alerts + Kafka "alerts" with MinIO evidence images.
ANOMALY_ALERTS_TOPIC=alerts
ANOMALY_TRUCK_API_URL=http://truck-sim:8240
# Rule thresholds (spec defaults).
ANOMALY_WRONGWAY_DEG=120
ANOMALY_WRONGWAY_HOLD_S=2
ANOMALY_ABANDONED_S=120
ANOMALY_PARKING_S=300
ANOMALY_ROUTE_COSINE=0.4
ANOMALY_ROUTE_OFFROUTE_M=800
ANOMALY_ROUTE_HOLD_S=90
ANOMALY_AE_THRESHOLD_PCT=99
ANOMALY_EVIDENCE_BUCKET=evidence
# Public base for evidence URLs attached to alerts (host-reachable MinIO S3 port).
ANOMALY_EVIDENCE_URL_BASE=http://localhost:9000/evidence

# --- Shared camera frame bus (ingest/anpr -> Redis Streams) -----------------
# ingest/anpr mirrors sampled jpeg frames to frames.{camera_id} for ai/anomaly.
ANPR_PUBLISH_FRAMES=true
ANPR_FRAME_BUS_MAXLEN=600
ANPR_FRAME_JPEG_QUALITY=70

# --- API gateway + fallback orchestrator (gateway, port 8000) ---------------
# The single public-facing service. Encodes the three fallback chains. Upstream
# URLs default to the jnpa service names; override only for unusual topologies.
# GATEWAY_VAHAN_LIVE_URL=http://vahan-live:8202
# GATEWAY_VAHAN_SIM_URL=http://vahan-sim:8201
# ULIP relay for the SECONDARY truck rung — empty uses a deterministic mock.
GATEWAY_ULIP_URL=
# Upstream call budget: >2 s lag means the ANPR feed is no longer "LIVE".
GATEWAY_UPSTREAM_TIMEOUT_S=2.0
GATEWAY_ANPR_LAG_S=2.0
# Cache TTLs (seconds): Vahan 12 h, ANPR frame window 60 s.
GATEWAY_CACHE_TTL_VAHAN_S=43200
GATEWAY_CACHE_TTL_ANPR_S=60
# Provisional admission cure window (hours) + elevated-scrutiny gate boom delay.
GATEWAY_PROVISIONAL_WINDOW_H=24
GATEWAY_GATE_BOOM_DELAY_S=5
# Decision ring buffer size (demo evidence) + 1-in-N truck-position WS sampling.
GATEWAY_DECISION_RING_SIZE=1000
GATEWAY_TRUCK_SAMPLE=50
# Automatic congestion alerting: a segment whose predicted congestion probability
# crosses this threshold auto-raises a TRAFFIC_CONGESTION alert (jnpa.alerts +
# jnpa.notifications) and fans it out over WS + WebPush/FCM. Set >1.0 to disable.
CONGESTION_ALERT_THRESHOLD=0.80
# WebPush (trucking-app PWA re-route notifications). Generate with
# `make vapid-keys` (appends the keys here). Leave blank to run the demo on the
# WebSocket + in-app-polling fallback only — push is best-effort and optional.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@jnpa-uc3.example
# Firebase Cloud Messaging (production push transport, added ALONGSIDE WebPush).
# Point FIREBASE_SERVICE_ACCOUNT_PATH at the Admin-SDK JSON key (NEVER commit it;
# mount it as a secret). Leave blank to disable FCM — delivery then falls back to
# WebPush + WebSocket. GOOGLE_APPLICATION_CREDENTIALS / FIREBASE_CREDENTIALS_JSON
# (inline JSON) are also honoured.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- Trucking-App PWA (mobile-pwa, served at web :3000/pwa) ------------------
# Build-time gateway URL used by the PWA's Vite dev proxy only (the PWA always
# calls the relative /api path; nginx proxies it in the web image). The PWA is
# bundled into the web image and served at /pwa, so it shares the web origin.
PWA_GATEWAY_URL=http://localhost:8000
# REQUIRED for driver login. The PWA presents this shared secret to
# POST /api/auth/device-token to mint its DRIVER token; without it the endpoint
# returns 401 and NO DRIVER CAN LOG IN — there is no dev seam in a prod bundle.
# Must match the value the PWA is built with (VITE_PWA_PAIRING_SECRET).
# `make env-init` generates one.  See mobile-pwa/src/lib/api.ts.
PWA_PAIRING_SECRET=__GENERATE_ME__

# --- Control-room dashboard (web, port 3000) --------------------------------
# Mapbox style token for the dashboard's primary basemap (free tier OK). Leave
# blank to use the Bhuvan (ISRO) WMS fallback basemap — the map renders either
# way. Passed to the web image as a Vite build arg (VITE_MAPBOX_TOKEN).
MAPBOX_TOKEN=
# Bhuvan (ISRO) WMS endpoint used as the fallback basemap provider.
VITE_BHUVAN_WMS=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms

# --- Truck fleet simulator (ingest/trucking_app + truck-sim) -----------------
# Statistical fleet size. TRUCK_NUM_DEVICES is the working population; the
# simulator never instantiates N objects per tick, so MAX is a safety ceiling
# for the correlator's ring buffers rather than a memory multiplier.
TRUCK_NUM_DEVICES=400
TRUCK_MAX_DEVICES=4000
# Radius (km) around the port that trip origins are sampled from.
TRUCK_ORIGIN_RADIUS_KM=8
# Modelled dwell inside the gate complex, seconds (feeds the TAT KPI).
TRUCK_GATE_DWELL_S=900

# --- OSRM routing (reroute advisories, ETA recompute) ------------------------
# Public demo server by default. For an offline/venue run, point this at a local
# OSRM container; an unreachable OSRM degrades to straight-line ETA, never fails.
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_TIMEOUT_S=1.0

# --- Demo-mode toggles -------------------------------------------------------
# FASTag demo mode serves deterministic balances/transactions instead of calling
# the (unconfigured) ULIP provider, so the FASTag tab is populated offline.
FASTAG_DEMO_MODE=true
# Per-source timeout for the congestion aggregator's upstream fan-out (seconds).
CONGESTION_SOURCE_TIMEOUT_S=3

# --- JNPA Simulated Port-Data API (dt.jnpa.in) -------------------------------
# BACKEND-ONLY credentials (never a VITE_ var). Empty CLIENT_KEY -> the sync
# loop never starts and /api/integrations/jnpa/health reports DISABLED.
# URL empty -> the client's official default (dt.jnpa.in/poc-api-data-access);
# point it at the local sim (http://jnpa-sim:8500) for offline work.
JNPA_PORTDATA_API_URL=
JNPA_PORTDATA_CLIENT_KEY=
# dt.jnpa.in allowlists the remote desktop's static IP; that egress is only
# reachable through the SOCKS5 tunnel on the jnpa3 EC2. From THIS machine use
# the public address below; from a container ON the EC2 use the private one
# (socks5://172.31.37.14:1080) — "localhost" inside a container is the
# container itself. Unset to go direct from an allowlisted address.
JNPA_PORTDATA_PROXY=socks5://65.2.212.121:1080

# --- Corridor geometry ------------------------------------------------------
CORRIDOR_NAME=NH-348 JNPA to Karal Phata
PORT_LAT=18.9489
PORT_LON=72.9492
KARAL_LAT=18.78
KARAL_LON=73.08

# --- Observability ----------------------------------------------------------
# Optional trace id stamped onto every structured log line.
TRACE_ID=local-dev
