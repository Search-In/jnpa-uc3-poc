# ============================================================================
# JNPA UC-III PoC — local environment
# Copy this file to `.env.local` and fill in the API keys before `make up`.
#   cp .env.local.example .env.local
# Everything internal uses Etc/UTC; convert to Asia/Kolkata only at the
# dashboard layer.
# ============================================================================

# --- Postgres ---------------------------------------------------------------
# ACTIVE (AWS RDS PostgreSQL) — cutover from the local container. Every service
# reads its DSN from these vars (compose uses ${VAR:-default}), so setting them
# here routes 100% of DB traffic to RDS and the local `postgres` container is
# bypassed entirely (nothing connects to it).
# THIS IS AN EXAMPLE FILE AND IS COMMITTED: it carries PLACEHOLDERS only.
# Fill the real endpoint/credentials in your own `.env.local` (gitignored), or
# run `bash deploy/aws/use-rds.sh .env` which substitutes them from $RDS_HOST /
# $RDS_USER / $RDS_PASSWORD. Use the least-privilege `jnpa_app` role, never the
# `postgres` superuser — see docs/RDS_SECURITY.md.
# SSL NOTE: asyncpg needs ?ssl=require; libpq needs ?sslmode=require — do NOT
# normalise them to the same token.
# NETWORK NOTE: the RDS security group must allow THIS host. On the EC2 box it
# works as-is; from a laptop it times out unless your public IP is added to the
# RDS security group.
POSTGRES_PASSWORD=__RDS_PASSWORD__
POSTGRES_DSN=postgresql+asyncpg://__RDS_USER__:__RDS_PASSWORD__@__RDS_HOST__:5432/jnpa_schema_v3?ssl=require
RFID_POSTGRES_DSN=postgresql://__RDS_USER__:__RDS_PASSWORD__@__RDS_HOST__:5432/jnpa_schema_v3?sslmode=require
TRUCK_POSTGRES_DSN=postgresql://__RDS_USER__:__RDS_PASSWORD__@__RDS_HOST__:5432/jnpa_schema_v3?sslmode=require
CONGESTION_POSTGRES_DSN=postgresql://__RDS_USER__:__RDS_PASSWORD__@__RDS_HOST__:5432/jnpa_schema_v3?sslmode=require
ANOMALY_POSTGRES_DSN=postgresql://__RDS_USER__:__RDS_PASSWORD__@__RDS_HOST__:5432/jnpa_schema_v3?sslmode=require
#
# --- LOCAL container (DISABLED — was active before the RDS cutover; kept so the
#     cutover is one-line reversible: re-enable these five and comment the RDS
#     block above). The local volume was initialised with TempPass123!. ---------
# POSTGRES_PASSWORD=TempPass123!
# POSTGRES_DSN=postgresql+asyncpg://postgres:TempPass123!@postgres:5432/postgres
# RFID_POSTGRES_DSN=postgresql://postgres:TempPass123!@postgres:5432/postgres
# TRUCK_POSTGRES_DSN=postgresql://postgres:TempPass123!@postgres:5432/postgres
# CONGESTION_POSTGRES_DSN=postgresql://postgres:TempPass123!@postgres:5432/postgres
# ANOMALY_POSTGRES_DSN=postgresql://postgres:TempPass123!@postgres:5432/postgres

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Determinism / demo mode ------------------------------------------------
# Single global seed for the whole simulated twin. Every simulator derives its
# own stream seed from this (jnpa_shared.config.derive_seed), so a recorded
# runbook replays byte-identically under the same SEED.
SEED=1337
# DATA_MODE: "mock" = offline-first, no external network; "live" = connectors
# may reach external APIs when keys are present. Frontend reads VITE_DATA_MODE.
DATA_MODE=mock
# OFFLINE=true forbids any network egress from simulators even if keys exist
# (used by the network-disabled acceptance run). Implies DATA_MODE=mock.
OFFLINE=false
# Wrap backbone events in a CloudEvents 1.0 envelope tagged sourcesystem=SIM/LIVE
# with a rawref pointer. Consumers auto-unwrap, so this is safe to leave on.
CLOUDEVENTS_ENABLED=true

# --- Kafka ------------------------------------------------------------------
# Internal listener (service name). From the host use localhost:29092.
KAFKA_BROKERS=kafka:9092

# --- MQTT (Mosquitto) -------------------------------------------------------
MQTT_BROKER=mosquitto:1883

# --- MinIO (model artefacts + ANPR snapshots) -------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- External map / traffic / weather APIs ----------------------------------
# Google Maps Platform key — https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=
# HERE Maps freemium key — https://platform.here.com/
HERE_API_KEY=_9o0csVr9ZpUoiXZEInjNpTY7WNIf5KjUM08ZHp7A8Y
# Per-source live-fetch budget for the congestion cascade (default 1.0 s
# is too tight for a cold TLS handshake to hereapi.com on this network).
CONGESTION_SOURCE_TIMEOUT_S=3
# TomTom developer key — https://developer.tomtom.com/ (backend-only; enables
# the LIVE rung on /api/traffic/current)
TOMTOM_API_KEY=E3bk7gmmiJgr2DvtcGM6oi7RXddSaIxb
# HTTP timeout per attempt in seconds / retry count (timeout/network/5xx only)
TOMTOM_TIMEOUT_S=5
TOMTOM_RETRIES=2
# OpenWeather key — https://openweathermap.org/api (backend-only; enables the
# openweather block on /api/weather/current)
OPENWEATHER_API_KEY=b8031dc9abe1c7c0ca8a6c55ef4e92a1
# WorldTides tide block for /api/weather — https://www.worldtides.info/developer
WORLDTIDES_API_KEY=9e56532d-36bc-49a0-9540-0eb710187865

# --- Bhuvan WMS (ISRO/NRSC geospatial layer, /api/bhuvan) --------------------
# Standard OGC WMS — NO API key. The gateway only validates availability and
# serves the layer config; the browser renders the WMS tiles directly on the
# ArcGIS map (Live Operations → Layers → Bhuvan Satellite Layer).
BHUVAN_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms
BHUVAN_LAYER=india3
BHUVAN_ENABLED=true
BHUVAN_TIMEOUT_S=5
BHUVAN_RETRIES=2

# --- ULIP Logistics Intelligence (/api/logistics/*) --------------------------
# ULIP (Unified Logistics Interface Platform, DPIIT) account credentials —
# https://www.ulip.dpiit.gov.in/ (registration required). BACKEND-ONLY: read
# by the gateway and sent only to the ULIP platform; never exposed as a VITE_
# variable or called from the browser. Auth: either the login pair below
# (POST /user/login token flow) or the pre-issued static ULIP_API_KEY further
# down. All empty -> the LIVE rung is disabled and /api/logistics/* degrades
# through CACHED (Redis) -> DATABASE -> FALLBACK (explicitly empty — no
# fabricated shipment data).
# URL empty/unset -> the official endpoint (built-in default
# https://www.ulip.dpiit.gov.in/ulip/v1.0.0); override for staging or a proxy.
ULIP_API_URL=
ULIP_CLIENT_ID=
ULIP_CLIENT_SECRET=
# HTTP timeout per attempt in seconds
ULIP_TIMEOUT_S=5
# Retry count for timeout/network/5xx failures (4xx incl. 401/403/429 fail fast)
ULIP_RETRIES=2
# Login-token reuse window in seconds (login mode only)
ULIP_TOKEN_TTL_S=1800
# ULIP API paths — one env per granted API; blank uses the documented default.
# Overridable because NLDSL versions these paths independently of the account.
ULIP_FASTAG_API=          # default FASTAG/01  toll crossings (72 h retention!)
ULIP_FASTAG_TAG_API=      # default FASTAG/02  tag registry / status
ULIP_LDB_API=             # default LDB/01     container tracking
ULIP_VAHAN_RC_API=        # default VAHAN/04   RC by vehicle no. (native JSON)
ULIP_VAHAN_RC_XML_API=    # default VAHAN/01   RC by vehicle no. (XML-in-JSON)
ULIP_VAHAN_CHASSIS_API=   # default VAHAN/02   RC by chassis no.
ULIP_VAHAN_ENGINE_API=    # default VAHAN/03   RC by engine no.
ULIP_SARATHI_DL_API=      # default SARATHI/02 DL by licence no.
ULIP_SARATHI_DL_DOB_API=  # default SARATHI/01 DL by licence no. + DOB
ULIP_GS_NH_ROAD_API=      # default GATISHAKTI/01  NH road detail
ULIP_GS_STATE_ROADS_API=  # default GATISHAKTI/02  state road network
ULIP_GS_ROAD_POINTS_API=  # default GATISHAKTI/03  road points (lat/lon)
ULIP_GS_TOLL_PLAZAS_API=  # default GATISHAKTI/04  NHAI toll plazas
GATEWAY_CACHE_TTL_ULIP_S=300
GATEWAY_CACHE_TTL_GATISHAKTI_S=3600

# Master switch for outbound ULIP traffic. OFF by default and deliberately
# separate from the credential: NLDSL gates POST /user/login on a source-IP
# allowlist and answers HTTP 412 "Access denied" — identically for a
# nonexistent username — until the deployment's egress IP is registered. So a
# credential being present says nothing about whether calls will work. Turn on
# only after `python scripts/ulip_smoke.py` returns a live 200.
ULIP_LIVE_ENABLED=0

# --- FASTag toll accumulator (services/fastag/poller.py) --------------------
# ULIP's FASTAG/01 keeps only the past 72 hours of crossings per vehicle, so
# toll history has to be swept up continuously rather than fetched on demand;
# a gap longer than 72 h loses data permanently with no way to backfill it.
FASTAG_POLL_INTERVAL_S=3600
FASTAG_POLL_ACTIVE_DAYS=7
FASTAG_POLL_MAX_PLATES=500

# --- Indian Govt / vehicle data APIs ----------------------------------------
# ULIP (Unified Logistics Interface Platform) — https://www.ulip.dpiit.gov.in/
ULIP_API_KEY=
# ISRO Bhuvan geo-services — https://bhuvan.nrsc.gov.in/
BHUVAN_API_KEY=

# --- LDB / NLDS (Logistics Data Bank, /api/ldb) ------------------------------
# Base URL for the NLDS LDB v2 API used by gateway/routers/ldb.py:
#   POST {LDB_BASE_URL}/truck/search  {"vehiclenumber": "MH43CQ0554"}
# Set => LIVE rung (calls audited to core.integration_lookup); blank => MOCK.
LDB_BASE_URL=https://ldb.co.in/api/ldbv2
# Optional bearer token for the LDB call. The public ldb.co.in endpoint needs
# none; leave blank unless a subscription key is issued.
LDB_API_KEY=

# --- Vahan simulator / live adapter -----------------------------------------
# Number of deterministic plates the simulator generates (default 25000).
VAHAN_TOTAL_PLATES=25000
# Artificial Parivahan-like latency per lookup (ms): mean +/- jitter.
VAHAN_LATENCY_MEAN_MS=100
VAHAN_LATENCY_JITTER_MS=50

# --- ANPR + OCR inference service (ai/anpr, port 8301) ----------------------
# YOLO detector confidence threshold.
ANPR_DETECT_CONF=0.25
# Held-out benchmark size (plates) and the combined-accuracy target for /eval.
ANPR_EVAL_SIZE=8
ANPR_EVAL_TARGET_PCT=95.0
# Expected SHA-256 of the YOLO plate weights; when set, startup hash-verifies
# the weights file and refuses to load on mismatch. Blank = check skipped.
ANPR_YOLO_SHA256=2d95861825bb4184404344c9cf809f40fd31dba785fe54e8ba5b9a3583789822
# MinIO bucket the service persists/loads YOLO weights from.
ANPR_MODEL_BUCKET=models

# --- Congestion forecaster (ai/congestion, port 8311) -----------------------
# Days of synthetic bootstrap history + training epochs (first-boot training).
CONGESTION_HISTORY_DAYS=14
CONGESTION_EPOCHS=50
# Bid target gates; train.py exits non-zero if the held-out metrics miss these.
CONGESTION_TARGET_F1=0.85
CONGESTION_TARGET_PRECISION=0.80
CONGESTION_TARGET_RECALL=0.80
# Kafka topic the per-minute prediction scheduler publishes to.
CONGESTION_PREDICTIONS_TOPIC=traffic.predictions
CONGESTION_PUBLISH_INTERVAL_S=60

# --- Behavioural anomaly detector (ai/anomaly, port 8321) -------------------
# Hybrid: ByteTrack + rule engine + trajectory autoencoder. Consumes the shared
# Redis frame bus (frames.{camera_id}) + Kafka truck.telemetry; writes alerts to
# jnpa.alerts + Kafka "alerts" with MinIO evidence images.
ANOMALY_ALERTS_TOPIC=alerts
ANOMALY_TRUCK_API_URL=http://truck-sim:8240
# Rule thresholds (spec defaults).
ANOMALY_WRONGWAY_DEG=120
ANOMALY_WRONGWAY_HOLD_S=2
ANOMALY_ABANDONED_S=120
ANOMALY_PARKING_S=300
ANOMALY_ROUTE_COSINE=0.4
ANOMALY_ROUTE_OFFROUTE_M=800
ANOMALY_ROUTE_HOLD_S=90
ANOMALY_AE_THRESHOLD_PCT=99
ANOMALY_EVIDENCE_BUCKET=evidence
# Public base for evidence URLs attached to alerts (host-reachable MinIO S3 port).
ANOMALY_EVIDENCE_URL_BASE=http://localhost:9000/evidence

# --- Shared camera frame bus (ingest/anpr -> Redis Streams) -----------------
# ingest/anpr mirrors sampled jpeg frames to frames.{camera_id} for ai/anomaly.
ANPR_PUBLISH_FRAMES=true
ANPR_FRAME_BUS_MAXLEN=600
ANPR_FRAME_JPEG_QUALITY=70

# --- API gateway + fallback orchestrator (gateway, port 8000) ---------------
# The single public-facing service. Encodes the three fallback chains. Upstream
# URLs default to the jnpa service names; override only for unusual topologies.
# GATEWAY_VAHAN_SIM_URL=http://vahan-sim:8201
# ULIP relay for the SECONDARY truck rung — empty uses a deterministic mock.
GATEWAY_ULIP_URL=
# Upstream call budget: >2 s lag means the ANPR feed is no longer "LIVE".
GATEWAY_UPSTREAM_TIMEOUT_S=2.0
GATEWAY_ANPR_LAG_S=2.0
# Cache TTLs (seconds): Vahan 12 h, ANPR frame window 60 s.
GATEWAY_CACHE_TTL_VAHAN_S=43200
GATEWAY_CACHE_TTL_ANPR_S=60
# Provisional admission cure window (hours) + elevated-scrutiny gate boom delay.
GATEWAY_PROVISIONAL_WINDOW_H=24
GATEWAY_GATE_BOOM_DELAY_S=5
# Decision ring buffer size (demo evidence) + 1-in-N truck-position WS sampling.
GATEWAY_DECISION_RING_SIZE=1000
GATEWAY_TRUCK_SAMPLE=50
# Trucking-app fleet size. The compose default (20000) — and even 2000 — pegs a
# CPU core AND floods the public OSRM demo server (router.project-osrm.org) with
# route/ETA fetches, starving the truck-sim asyncio loop so /devices/list &
# /devices/{id}/route intermittently take 5-12 s -> the gateway (12 s budget)
# reports Advisory degraded:[] and Push Re-route 502 truck_sim_unreachable.
# 400 devices keeps the sim loop responsive (<0.5 s list) while still filling the
# AT_GATE_QUEUE advisory queue and the gate/telemetry KPIs. Raise on a bigger host.
TRUCK_NUM_DEVICES=400
TRUCK_MAX_DEVICES=4000
# Draw truck origins within 8 km of a gate (default 100 km) so trucks reach the
# port and enter AT_GATE_QUEUE within a minute or two — otherwise the whole fleet
# sits EN_ROUTE_TO_PORT for ~2 h and the Driver-Advisory queue stays empty.
TRUCK_ORIGIN_RADIUS_KM=8
# Standing AT_GATE_QUEUE dwell (default 120 s). 900 s keeps a visible queue of
# trucks parked at each gate so the Advisory page always has rows to show.
TRUCK_GATE_DWELL_S=900
# CRITICAL: the public OSRM *demo* server is rate-limited and slow, and blocking
# on it inside the sim loop is the real cause of the truck-sim unresponsiveness
# (Advisory degraded / Push Re-route 502). Point routing at an instantly-refused
# local address so the sim uses its built-in corridor dead-reckon router (local,
# no network) — routes/ETAs stay plausible and the loop never blocks on an
# external call. For production, run a self-hosted OSRM and set a reachable URL.
OSRM_BASE_URL=http://127.0.0.1:9/route/v1/driving/
OSRM_TIMEOUT_S=1.0
# Automatic congestion alerting: a segment whose predicted congestion probability
# crosses this threshold auto-raises a TRAFFIC_CONGESTION alert (jnpa.alerts +
# jnpa.notifications) and fans it out over WS + WebPush/FCM. Set >1.0 to disable.
CONGESTION_ALERT_THRESHOLD=0.80

# --- UC-3 · Peak yard utilisation + truck arrival management (/api/yard) -----
# Utilisation bands for the yard board and the arrival manager. At/above HIGH
# the yard is flagged constrained; CRITICAL is both the red band AND the
# operating ceiling the yard plans up to (it never plans to fill the last slot),
# so at CRITICAL nothing further is admitted and approaching trucks are held.
YARD_HIGH_UTILIZATION_PCT=90
YARD_CRITICAL_UTILIZATION_PCT=95
# Ground slots one arriving laden trailer consumes.
YARD_SLOTS_PER_TRUCK=2
# Observed yard evacuation rate, used ONLY for the estimated-wait figure shown
# to held drivers. 0 -> no estimate is shown (never fabricated).
YARD_RELEASE_RATE_SLOTS_PER_HOUR=0
# Authorised facility recommended first when it has room (core.parking_facility).
YARD_PREFERRED_PARKING_FACILITY=PK-CPP
# Yard congestion-pressure score above which a TRAFFIC_CONGESTION alert is
# raised through services/congestion_alert.py (same dedup, same alert feed).
YARD_PRESSURE_ALERT_THRESHOLD=0.80
# WebPush (trucking-app PWA re-route notifications). Generate with
# `make vapid-keys` (appends the keys here). Leave blank to run the demo on the
# WebSocket + in-app-polling fallback only — push is best-effort and optional.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@jnpa-uc3.example
# Firebase Cloud Messaging — FCM push + Phone-Auth verify. The Admin-SDK key is
# kept OUTSIDE the repo (Downloads/) and loaded by absolute path; never commit it.
FIREBASE_PROJECT_ID=jnpa3-e23e8
FIREBASE_SERVICE_ACCOUNT_PATH=/Users/pandurangdhage/Downloads/jnpa3-e23e8-firebase-adminsdk-fbsvc-a50827ec68.json

# --- Trucking-App PWA (mobile-pwa, served at web :3000/pwa) ------------------
# Build-time gateway URL used by the PWA's Vite dev proxy only (the PWA always
# calls the relative /api path; nginx proxies it in the web image). The PWA is
# bundled into the web image and served at /pwa, so it shares the web origin.
PWA_GATEWAY_URL=http://localhost:8000

# --- Control-room dashboard (web, port 3000) --------------------------------
# Mapbox style token for the dashboard's primary basemap (free tier OK). Leave
# blank to use the Bhuvan (ISRO) WMS fallback basemap — the map renders either
# way. Passed to the web image as a Vite build arg (VITE_MAPBOX_TOKEN).
MAPBOX_TOKEN=
# Bhuvan (ISRO) WMS endpoint used as the fallback basemap provider.
VITE_BHUVAN_WMS=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms

# --- Corridor geometry ------------------------------------------------------
CORRIDOR_NAME=NH-348 JNPA to Karal Phata
PORT_LAT=18.9489
PORT_LON=72.9492
KARAL_LAT=18.78
KARAL_LON=73.08

# --- Observability ----------------------------------------------------------
# Optional trace id stamped onto every structured log line.
TRACE_ID=local-dev

# --- added for local single-driver demo E2E (Claude) ---
GRAFANA_ADMIN_PASSWORD=demo-grafana
# Grafana datasource -> RDS (matches POSTGRES_DSN host). Other GRAFANA_PG_* vars
# fall back to compose defaults: DB jnpa_schema_v3, sslmode require.
GRAFANA_PG_HOST=__RDS_HOST__:5432
# An unauthenticated gateway attaches no principal, and /api/drivers/master then
# served 31.8k real licence numbers to anyone who could reach the port (audit
# 2026-08-04). Auth is ON by default here; AUTH_DEV_TOKENS keeps the passwordless
# /api/auth/dev-token seam available for the local demo ONLY (it refuses to run
# in any production-like APP_ENV).
AUTH_ENABLED=true
VITE_AUTH_ENABLED=true
AUTH_DEV_TOKENS=true
# Must be set and non-default whenever AUTH_ENABLED=true, or the gateway refuses
# to start (gateway/auth.py validate_auth_config C2). Replace before use.
AUTH_JWT_SECRET=change-me-auth-secret

# --- PII (DPDP) -------------------------------------------------------------
# Licence/Aadhaar/mobile are masked unless the caller's role is listed here.
PII_MASKING_ENABLED=true
PII_UNMASK_ROLES=DTCCC_ADMIN,CUSTOMS
PWA_PAIRING_SECRET=change-me-pairing-secret
FASTAG_DEMO_MODE=true

# --- SecureVision AI surveillance platform (/api/sv/*) -----------------------
# BACKEND-ONLY credentials for the gateway's SecureVision service account.
# NEVER prefix these with VITE_: the browser must not hold them, and SecureVision
# authenticates at /api/auth/login — the same relative path as this app's own
# sign-in — so a browser-direct call would collide with JNPA authentication.
# Empty credentials => the integration is disabled (every /api/sv route answers
# NOT_CONFIGURED); no existing JNPA screen is affected.
SECUREVISION_BASE_URL=https://svapidev.phylon.in
SECUREVISION_USERNAME=
SECUREVISION_PASSWORD=
SECUREVISION_TIMEOUT_S=15
SECUREVISION_UPLOAD_TIMEOUT_S=180
SECUREVISION_RETRIES=2
SECUREVISION_TOKEN_TTL_S=1800
SECUREVISION_STREAM_TICKET_TTL_S=120
# Explicit SecureVision -> JNPA camera mapping (JSON object). SecureVision has no
# camera-registry API, so this is the only join between the two registries.
# Example: {"CAM-01":"CAM-NSICT-ENT","CAM-02":"CAM-COR-01"}
# Unmapped codes render as "Camera mapping unavailable" rather than being guessed.
SECUREVISION_CAMERA_MAP=
