# ============================================================================
# JNPA UC-III PoC — QA environment (dedicated QA EC2 instance)
#
# Copy this file to `.env.qa` on the EC2 instance and fill in the credentials:
#   cp .env.qa.example .env.qa && chmod 600 .env.qa
#
# This is the QA twin of .env.aws.example. It differs ONLY in:
#   * the Postgres database name          jnpa_schema_v3 -> jnpa_qa
#   * APP_ENV                             production     -> qa
#   * the public origin                   prod domain    -> __QA_HOST__
#     (MINIO_PUBLIC_ENDPOINT, ANOMALY_EVIDENCE_URL_BASE, CORS_ALLOW_ORIGINS)
# Everything else is identical, so QA exercises the production code paths.
#
# TWO PLACEHOLDERS ARE SUBSTITUTED ON THE BOX, everywhere they appear:
#   __RDS_HOST__  the RDS endpoint      (never committed — docs/RDS_SECURITY.md)
#   __QA_HOST__   qa.searchintech.in    (the QA TLS hostname)
# `deploy/qa/bootstrap-ec2.sh` does both, along with the <SET_ON_EC2_ONLY>
# secrets. Nothing may remain unsubstituted before the first `up`.
#
# NEVER commit the filled-in copy — .env.qa is git-ignored. Every `<SET_ON_EC2_ONLY>`
# below must be supplied on the EC2 box only. All internal services run on Etc/UTC.
#
# Full runbook: QA_DEPLOYMENT.md
# ============================================================================

# --- Postgres: AWS RDS, QA DATABASE ------------------------------------------
# QA uses a SEPARATE database on the SAME RDS instance as production. The
# production database name must never appear in this file.
#
#   host  __RDS_HOST__   <-- same endpoint as production; supplied on EC2, see below
#   port  5432
#   db    jnpa_qa        <-- QA only (production runs a different database)
#   user  jnpa_app       <-- least-privilege application role, NOT the superuser
#
# There is NO local postgres container in a deployment (it is dev-only, behind
# the "localdb" compose profile), so every service connects to RDS.
#
# SECURITY — docs/RDS_SECURITY.md applies here exactly as it does to production:
#   * The endpoint hostname stays a PLACEHOLDER. The 2026-08-04 audit found it
#     committed in cleartext in 24 files, and tests/test_rds_security.py now
#     FAILS the build if a concrete *.rds.amazonaws.com host reappears. Supply it
#     on the EC2 box via $RDS_HOST — QA_DEPLOYMENT.md §3.
#   * The PASSWORD is never committed either: replace every `<SET_ON_EC2_ONLY>`
#     on the box (URL-encode any of  : / ? # [ ] @  in it).
#   * The user is `jnpa_app`, the least-privilege application role, NOT the
#     `postgres` superuser — docs/RDS_SECURITY.md §3. It needs CONNECT on
#     jnpa_qa plus DML on the QA schema; it must not be able to run DDL or read
#     other databases. Grant it on jnpa_qa before the first `up`.
#   * The instance must not be publicly accessible / the SG must not allow
#     0.0.0.0/0 on 5432 — docs/RDS_SECURITY.md §2.
#
# EASIEST WAY TO FILL THESE IN on the EC2 box — reuse the EXISTING writer; it
# takes host/db/user as overrides and rewrites only these six lines:
#   RDS_HOST=<the RDS endpoint> RDS_DB=jnpa_qa RDS_USER=jnpa_app RDS_PASSWORD='…' \
#     bash deploy/aws/use-rds.sh .env.qa
#
# SSL NOTE (do not "normalise" these): the async engine uses asyncpg, which
# accepts `ssl=require`; the libpq/psycopg DSNs need `sslmode=require`.
POSTGRES_PASSWORD=<SET_ON_EC2_ONLY>

# asyncpg / SQLAlchemy async engine (gateway, identity, cargo/UC-3 services,
# carbon, gate-data, parking, empty-container, scenarios, vahan-*).
POSTGRES_DSN=postgresql+asyncpg://jnpa_app:<SET_ON_EC2_ONLY>@__RDS_HOST__:5432/jnpa_qa?ssl=require

# libpq DSNs (surface to their services as POSTGRES_DSN_LIBPQ / *_POSTGRES_DSN).
RFID_POSTGRES_DSN=postgresql://jnpa_app:<SET_ON_EC2_ONLY>@__RDS_HOST__:5432/jnpa_qa?sslmode=require
TRUCK_POSTGRES_DSN=postgresql://jnpa_app:<SET_ON_EC2_ONLY>@__RDS_HOST__:5432/jnpa_qa?sslmode=require
CONGESTION_POSTGRES_DSN=postgresql://jnpa_app:<SET_ON_EC2_ONLY>@__RDS_HOST__:5432/jnpa_qa?sslmode=require
ANOMALY_POSTGRES_DSN=postgresql://jnpa_app:<SET_ON_EC2_ONLY>@__RDS_HOST__:5432/jnpa_qa?sslmode=require

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Kafka ------------------------------------------------------------------
KAFKA_BROKERS=kafka:9092

# --- MQTT (Mosquitto) -------------------------------------------------------
MQTT_BROKER=mosquitto:1883

# --- MinIO (model artefacts + ANPR snapshots + driver reference photos) -----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<SET_ON_EC2_ONLY>
MINIO_SECRET_KEY=<SET_ON_EC2_ONLY>
# The gateway's startup gate FAILS the boot if MinIO is unreachable (no base64
# fallback for reference photos). MinIO runs in-cluster on plain HTTP (minio:9000),
# so this MUST be false — setting it true makes the client speak TLS to a plaintext
# port and the boot dies with "[SSL: WRONG_VERSION_NUMBER]". Only set true if MinIO
# is actually fronted by TLS (e.g. via a sidecar/proxy with certs).
MINIO_SECURE=false
DRIVER_ENROL_BUCKET=drivers
# Browser-reachable S3 host used to MINT presigned driver-photo URLs. MinIO is
# not directly exposed; nginx reverse-proxies /minio/ -> minio:9000 (web/nginx/
# default.conf), so point this at the public domain + /minio sub-path. The
# gateway signs against the bare host and re-inserts /minio; nginx strips it
# before MinIO, so the SigV4 signature still matches. TLS terminates at nginx,
# so PUBLIC_SECURE is true even though in-cluster MINIO_SECURE stays false.
# QA terminates TLS in its own web container for `qa.searchintech.in` on the
# host's 443 (docker-compose.qa.yml + web/nginx/default.qa.conf), so this is a
# bare hostname with NO port suffix and PUBLIC_SECURE is true.
#
# Both values are load-bearing, in different ways:
#   * a `http://` origin here (PUBLIC_SECURE=false) mints presigned URLs the
#     browser refuses to load from the HTTPS dashboard — mixed-content block,
#     and driver photos silently render broken;
#   * the host is part of what SigV4 signs, so it must be the host the browser
#     actually sends. Getting it wrong yields SignatureDoesNotMatch, not a 404.
# Replace __QA_HOST__ with the QA hostname (qa.searchintech.in).
MINIO_PUBLIC_ENDPOINT=__QA_HOST__/minio
MINIO_PUBLIC_SECURE=true

# --- Grafana admin (SEC-4: no hard-coded creds; compose fails fast if unset) -
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<SET_ON_EC2_ONLY>

# --- Grafana Postgres datasource (infra/grafana/provisioning/datasources) ----
# REQUIRED. docker-compose.yml declares GRAFANA_PG_HOST as ${GRAFANA_PG_HOST:?},
# and compose evaluates interpolation for EVERY service before starting ANY of
# them — so leaving this unset aborts the entire stack, not just Grafana.
#
# Same RDS instance as the application: host:PORT (note the port — this is a
# Grafana datasource URL, not a bare hostname).
#   The GitHub Actions deploy DERIVES these from the RDS_HOST / RDS_USER secrets
#   and rewrites them on every run (deploy.yml step "1b-GRAFANA"), so you only
#   fill these in for a MANUAL deploy.
GRAFANA_PG_HOST=__RDS_HOST__:5432
GRAFANA_PG_DB=jnpa_qa
# Least-privilege application role, same as the app (docs/RDS_SECURITY.md §3).
# Grafana only ever reads.
GRAFANA_PG_USER=jnpa_app
GRAFANA_PG_SSLMODE=require
# The datasource PASSWORD is read from POSTGRES_PASSWORD above — there is no
# GRAFANA_PG_PASSWORD variable. Setting one has no effect.

# --- Gateway auth + RBAC (Wave 3 / SEC-1, SEC-2) ----------------------------
# Production-adjacent: enable auth, set a strong secret + scoped CORS origins.
# APP_ENV != development makes the gateway FAIL TO START unless AUTH_ENABLED=true,
# AUTH_JWT_SECRET is set to a non-default value, and AUTH_DEV_TOKENS=false.
APP_ENV=qa
AUTH_ENABLED=true
# Belt-and-braces: production forces strict mode regardless, but set this false
# so no resilience fallback (in-memory store / base64 photo / synthetic identity)
# is ever taken. APP_ENV=qa also engages the identity service's startup
# safety gate (ArcFace + liveness models MUST load or it refuses to start).
ALLOW_FALLBACK=false
# REQUIRED. The deploy workflow replaces this placeholder with `openssl rand
# -hex 32`. Never ship the literal placeholder — startup validation rejects it.
AUTH_JWT_SECRET=<SET_ON_EC2_ONLY>
AUTH_RATE_LIMIT_PER_MIN=600
# Shared secret for trusted service-to-service calls (the scenarios-runner's
# scenario_step/routing/tas callbacks to the gateway). Both the gateway and the
# scenarios service read this same value; the deploy workflow backfills a random
# one if absent. The gateway accepts it via the X-Internal-Token header in place
# of a user JWT. Leave unset only in dev where AUTH_ENABLED=false.
INTERNAL_SERVICE_TOKEN=<SET_ON_EC2_ONLY>
# MUST be false outside development — the gateway refuses to start otherwise.
AUTH_DEV_TOKENS=false
# REQUIRED for the Driver PWA in production: gates POST /api/auth/device-token
# (which mints DRIVER-scoped tokens at pairing). Without it that route 404s and
# the PWA cannot authenticate. Inject the same value into the PWA build as
# VITE_PWA_PAIRING_SECRET. The seam where a real OTP / device-attestation flow
# replaces the shared secret post-award.
PWA_PAIRING_SECRET=<SET_ON_EC2_ONLY>
VITE_PWA_PAIRING_SECRET=<SET_ON_EC2_ONLY>
# PWA login eligibility gate. When true, POST /api/auth/device-token only mints a
# DRIVER token if the entered Vehicle ID is assigned to an ACTIVE driver
# (driver_enrollments -> drivers), else 403 "Vehicle is not assigned to an active
# driver". true for production/demo so unauthorized vehicles cannot pair; set
# false to allow any well-formed TRK-###### to pair (migration/testing only).
REQUIRE_DRIVER_PROFILE=true
# anpr-ingest: real YOLO detection + AI OCR. MUST be false in production — the
# ingest refuses to start with DRY_RUN=true outside development.
DRY_RUN=false
# Comma-separated allowed browser origins. The dashboard and PWA are served from
# the same origin they call (nginx proxies /api), so this can stay empty for
# normal use; set it only for out-of-origin callers such as Postman collections
# run from a browser, or a locally-served dev dashboard pointed at QA.
CORS_ALLOW_ORIGINS=https://__QA_HOST__
# DPDP: keep real-biometric processing OFF (post-award, consent-gated).
ALLOW_REAL_BIOMETRICS=false

# --- Identity / face-recognition (Appendix C #2) ----------------------------
# Production REQUIRES the real ArcFace embedder + anti-spoof liveness. With
# APP_ENV=qa the identity service FAILS TO START unless both ONNX models
# load (fetch with scripts/fetch_face_model.sh -> ./data/models, mounted /models).
IDENTITY_EMBEDDER=onnx
IDENTITY_ARCFACE_MODEL=/models/arcface.onnx
IDENTITY_VERIFY_THRESHOLD=0.45
IDENTITY_PROVISIONAL_THRESHOLD=0.30
# Liveness MUST be on in production — a missing model is a hard boot failure, and
# any un-checked frame is REJECTED (no spoof may pass).
IDENTITY_LIVENESS=true
IDENTITY_LIVENESS_MODEL=/models/antispoof.onnx
IDENTITY_LIVENESS_THRESHOLD=0.5
IDENTITY_LIVENESS_REAL_INDEX=0

# --- External map / traffic / weather APIs ----------------------------------
# Optional: Set these to go live. Leaving them blank keeps simulation active.
GOOGLE_MAPS_API_KEY=
HERE_API_KEY=
TOMTOM_API_KEY=
OPENWEATHER_API_KEY=

# --- Open-Meteo Weather + Marine (/api/weather) -----------------------------
# Public API, no API key required. The values below are the official public
# endpoints — also the built-in defaults, so leaving these unset works too;
# override only to route through a proxy or a self-hosted Open-Meteo instance.
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# HTTP timeout per attempt in seconds
OPEN_METEO_TIMEOUT_S=5
# Retry count for timeout/network/5xx failures
OPEN_METEO_RETRIES=2

# --- OpenWeatherMap (/api/weather "openweather" block) ----------------------
# Uses OPENWEATHER_API_KEY above. BACKEND-ONLY: the key is read by the gateway
# and sent only to api.openweathermap.org; never exposed to the frontend.
# Empty key -> the openweather block is disabled and /api/weather keeps
# serving Open-Meteo exactly as before.
OPENWEATHER_URL=https://api.openweathermap.org/data/2.5/weather
# HTTP timeout per attempt in seconds
OPENWEATHER_TIMEOUT_S=5
# Retry count for timeout/network/5xx failures (4xx incl. 401/429 fail fast)
OPENWEATHER_RETRIES=2

# --- TomTom Traffic (/api/traffic/current) ----------------------------------
# Uses TOMTOM_API_KEY above. BACKEND-ONLY: the key is read by the gateway and
# sent only to api.tomtom.com; never exposed to the frontend. Empty key -> the
# LIVE rung is disabled and /api/traffic/current degrades through
# CACHED (Redis) -> DATABASE -> SYNTHETIC.
TOMTOM_FLOW_URL=https://api.tomtom.com/traffic/services/4/flowSegmentData/absolute/10/json
TOMTOM_INCIDENTS_URL=https://api.tomtom.com/traffic/services/5/incidentDetails
# HTTP timeout per attempt in seconds
TOMTOM_TIMEOUT_S=5
# Retry count for timeout/network/5xx failures (4xx incl. 401/403/429 fail fast)
TOMTOM_RETRIES=2

# --- ULIP Logistics Intelligence (/api/logistics/*) --------------------------
# ULIP (DPIIT) account credentials. BACKEND-ONLY: read by the gateway and sent
# only to the ULIP platform; never exposed to the frontend. Auth: the login
# pair below (POST /user/login token flow) or the static ULIP_API_KEY further
# down. All empty -> LIVE rung disabled; /api/logistics/* degrades through
# CACHED (Redis) -> DATABASE -> FALLBACK (explicitly empty, never fabricated).
# URL empty -> official default https://www.ulip.dpiit.gov.in/ulip/v1.0.0.
ULIP_API_URL=
ULIP_CLIENT_ID=
ULIP_CLIENT_SECRET=
ULIP_TIMEOUT_S=5
ULIP_RETRIES=2
ULIP_TOKEN_TTL_S=1800
# ULIP API paths (defaults FASTAG/01 and LDB/01 — override per subscription)
ULIP_FASTAG_API=
ULIP_LDB_API=
GATEWAY_CACHE_TTL_ULIP_S=300

# --- Indian Govt / vehicle data APIs ----------------------------------------
# Surepass (Vahan / FASTag / RC lookups)
SUREPASS_API_TOKEN=
# ULIP (Unified Logistics Interface Platform)
ULIP_API_KEY=
# --- FASTag ULIP APIs (/api/fastag/*) — CONFIGURE against the authorised provider.
# Empty FASTAG_ULIP_URL => the module returns a config error (500) and never calls
# a vendor. Paths + auth are env-driven (no hardcoded URL; do NOT assume bearer).
#   FASTAG_ULIP_AUTH_SCHEME: bearer | apikey | none   FASTAG_ULIP_AUTH_HEADER: X-API-Key
FASTAG_ULIP_URL=
FASTAG_ULIP_ENROUTE_PATH=
FASTAG_ULIP_BALANCE_PATH=
FASTAG_ULIP_TRANSACTION_PATH=
FASTAG_ULIP_AUTH_SCHEME=bearer
FASTAG_ULIP_AUTH_HEADER=X-API-Key
FASTAG_ULIP_TIMEOUT_S=10
FASTAG_ULIP_RETRIES=2
# ISRO Bhuvan geo-services
BHUVAN_API_KEY=

# --- LDB / NLDS (Logistics Data Bank, /api/ldb) ------------------------------
# POST {LDB_BASE_URL}/truck/search — set => LIVE rung, blank => MOCK.
LDB_BASE_URL=https://ldb.co.in/api/ldbv2
LDB_API_KEY=

# --- Vahan simulator / live adapter -----------------------------------------
VAHAN_TOTAL_PLATES=25000
VAHAN_LATENCY_MEAN_MS=100
VAHAN_LATENCY_JITTER_MS=50

# --- ANPR + OCR inference service (ai/anpr) ---------------------------------
ANPR_DETECT_CONF=0.25
ANPR_EVAL_SIZE=200
ANPR_EVAL_TARGET_PCT=95.0
ANPR_YOLO_SHA256=
ANPR_MODEL_BUCKET=models

# --- Congestion forecaster (ai/congestion) ----------------------------------
CONGESTION_HISTORY_DAYS=14
CONGESTION_EPOCHS=50
CONGESTION_TARGET_F1=0.85
CONGESTION_TARGET_PRECISION=0.80
CONGESTION_TARGET_RECALL=0.80
CONGESTION_PREDICTIONS_TOPIC=traffic.predictions
CONGESTION_PUBLISH_INTERVAL_S=60

# --- Behavioural anomaly detector (ai/anomaly) ------------------------------
ANOMALY_ALERTS_TOPIC=alerts
ANOMALY_TRUCK_API_URL=http://truck-sim:8240
ANOMALY_WRONGWAY_DEG=120
ANOMALY_WRONGWAY_HOLD_S=2
ANOMALY_ABANDONED_S=120
ANOMALY_PARKING_S=300
ANOMALY_ROUTE_COSINE=0.4
ANOMALY_ROUTE_OFFROUTE_M=800
ANOMALY_ROUTE_HOLD_S=90
ANOMALY_AE_THRESHOLD_PCT=99
ANOMALY_EVIDENCE_BUCKET=evidence

# Public base for evidence URLs attached to alerts (MinIO S3 server).
# MinIO publishes NO host port under the QA overlay (`ports: !reset []`), so a
# :9000 URL is unreachable from a browser. Route it through the same nginx
# /minio/ proxy the driver photos use. Replace __QA_HOST__ with qa.searchintech.in.
ANOMALY_EVIDENCE_URL_BASE=https://__QA_HOST__/minio/evidence

# --- Shared camera frame bus (ingest/anpr -> Redis Streams) -----------------
ANPR_PUBLISH_FRAMES=true
ANPR_FRAME_BUS_MAXLEN=600
ANPR_FRAME_JPEG_QUALITY=70

# --- API gateway + fallback orchestrator (gateway) --------------------------
GATEWAY_UPSTREAM_TIMEOUT_S=2.0
GATEWAY_ANPR_LAG_S=2.0
GATEWAY_CACHE_TTL_VAHAN_S=43200
GATEWAY_CACHE_TTL_ANPR_S=60
GATEWAY_PROVISIONAL_WINDOW_H=24
GATEWAY_GATE_BOOM_DELAY_S=5
GATEWAY_DECISION_RING_SIZE=1000
GATEWAY_TRUCK_SAMPLE=50

# WebPush (trucking-app PWA re-route notifications).
# Generate on the box with `make vapid-keys` or `python scripts/gen_vapid_keys.py`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@jnpa-uc3.example

# Firebase Cloud Messaging (production push transport, added ALONGSIDE WebPush).
# Drop the Admin-SDK JSON in the host `secrets/` dir (mounted read-only into the
# gateway at /run/secrets/firebase; NEVER commit the key) and point the path at
# it. Blank disables FCM -> falls back to WebPush + WS.
FIREBASE_PROJECT_ID=jnpa3-e23e8
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase/firebase-adminsdk.json
# Override the host dir mounted at /run/secrets/firebase (default ./secrets).
# FIREBASE_SECRETS_DIR=./secrets

# --- Trucking-App PWA (mobile-pwa, served at web :3000/pwa) ------------------
PWA_GATEWAY_URL=http://localhost:8000

# --- Control-room dashboard (web, port 3000) --------------------------------
# Mapbox style token for the dashboard's primary basemap (free tier OK).
# Leave blank to fallback to the Bhuvan (ISRO) WMS basemap.
MAPBOX_TOKEN=
VITE_BHUVAN_WMS=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms
# Dashboard data source. Production deploys MUST be `live` (real gateway /api).
# The web image build is refused if the bundle is not live (see web/Dockerfile).
VITE_DATA_MODE=live

# --- JNPA Simulated Port-Data API (dt.jnpa.in) -------------------------------
# BACKEND-ONLY credentials (never a VITE_ var). Empty CLIENT_KEY -> the sync
# loop never starts and /api/integrations/jnpa/health reports DISABLED.
# URL empty -> the client's official default (dt.jnpa.in/poc-api-data-access).
JNPA_PORTDATA_API_URL=
JNPA_PORTDATA_CLIENT_KEY=
# dt.jnpa.in allowlists the remote desktop's static IP, tunneled to this EC2's
# SOCKS proxy on port 1080. Containers must use the HOST'S PRIVATE ADDRESS —
# "localhost" inside a container is the container itself. jnpa3 private IP:
JNPA_PORTDATA_PROXY=socks5://172.31.37.14:1080

# --- Corridor geometry ------------------------------------------------------
CORRIDOR_NAME=NH-348 JNPA to Karal Phata
PORT_LAT=18.9489
PORT_LON=72.9492
KARAL_LAT=18.78
KARAL_LON=73.08

# --- Observability ----------------------------------------------------------
TRACE_ID=aws-ec2-poc

# --- Upload size ceiling -----------------------------------------------------
# Largest accepted file upload, in MB. Default 32 — sized to admit the corpus's
# largest file (11-Transport Data/PDP Details.xlsx, 24 MB) with headroom, not to
# a round number. Applies to every ingest module at once (customs, shipping
# lines, gate docs, CFS/ECY, marine, transport).
# Keep it BELOW web/nginx client_max_body_size (40m) so the application returns
# the 413 with a JSON body naming the limit, rather than nginx returning HTML.
MAX_UPLOAD_MB=32
