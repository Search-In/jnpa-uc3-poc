# ============================================================================
# UC-1 one-command cold start (UC1-001) — LOCAL-ONLY environment.
#
#   Copy to .env.uc1-local, fill UC1_PG_PASSWORD, then:
#       powershell -ExecutionPolicy Bypass -File scripts\uc1-up.ps1
#
# This file is deliberately SEPARATE from .env.local. .env.local points the
# whole stack at the shared AWS RDS instance and is what the team uses day to
# day; nothing here touches it. scripts/uc1-up.ps1 exports the values below
# into the gateway process, and a process environment variable beats the
# .env.local entry of the same name (pydantic-settings precedence), so the
# cold-start gateway talks to the LOCAL database while .env.local stays valid
# for every other workflow.
# ============================================================================

# --- Local PostgreSQL ------------------------------------------------------
# The server that hosts jnpa_v3_local. UC1-001 specifies PostgreSQL 16; the
# script accepts any server >= 16 and prints the actual major version, so a
# machine running 17/18 is usable and the deviation is on the record rather
# than silent.
UC1_PG_HOST=127.0.0.1
UC1_PG_PORT=5432
UC1_PG_SUPERUSER=postgres
# REQUIRED. The superuser password for the server above. Needed to CREATE
# DATABASE and to restore the dump; the gateway then uses the same account
# because a local sandbox has no least-privilege role to grant.
UC1_PG_PASSWORD=

# Windows service to start when the server is not already accepting
# connections. Leave blank to skip service management (the script will then
# fail fast if the server is down rather than trying to start it).
UC1_PG_SERVICE=postgresql-x64-18

# Database name. UC1-001 fixes this value; changing it means the demo no
# longer matches the ticket.
UC1_DB_NAME=jnpa_v3_local

# --- Corpus dump -----------------------------------------------------------
# The JNPA corpus is NOT in git (no UC-1 seed or fixture ships in either repo),
# so a cold start restores it from a pg_dump archive.
#
# Path is relative to the repo root. backups/ is already gitignored — the
# archive carries real JNPA operational data and must never be committed.
UC1_DUMP_PATH=backups/jnpa_v3_local.dump

# Optional. When the dump file is ABSENT the script can produce it by dumping
# the shared RDS instance. Leave blank on a demo machine (the dump is then a
# hard prerequisite and the script says so); set it on a networked developer
# machine to regenerate the archive.
#   postgresql://postgres:PASSWORD@<rds-host>:5432/jnpa_schema_v3?sslmode=require
# See docs/RDS_SECURITY.md before putting a real endpoint here.
UC1_SOURCE_DSN=

# Table DATA excluded from the dump, comma-separated, schema-qualified.
# Structure is always kept — only the rows are skipped, so every foreign key
# and index still exists. Two reasons a table is on this list:
#   * volume  — truck_telemetry/anpr_read/rfid_read are UC-3 simulator output
#               and are 101 GB of the 103 GB source database. They are
#               regenerated by the simulators and no UC-1 KPI reads them.
#   * DPDP    — driver*/pdp carry real licence numbers and dates of birth.
#               A UC-1 marine demo has no use for them, so they do not get
#               copied onto a laptop.
UC1_DUMP_EXCLUDE_DATA=core.truck_telemetry,core.anpr_read,core.rfid_read,core.pdp,core.driver,core.driver_face,core.driver_enrollment,core.driver_identity,core.driver_license_lookup_history

# --- Demo account ----------------------------------------------------------
# Seeded into core.app_user by the EXISTING scripts/seed_auth_users.py — this
# file defines no login of its own and no password is hardcoded in any script.
#
# UC1-001 asks for admin/admin. gateway/users.py enforces
# MIN_PASSWORD_LENGTH = 8, so a 5-character password is rejected by the seeder.
# Rather than weaken that policy repo-wide or turn authentication off, the
# demo account keeps the username `admin` with an 8-character password.
UC1_DEMO_USER=admin
UC1_DEMO_PASSWORD=admin123

# --- Gateway ---------------------------------------------------------------
UC1_GATEWAY_HOST=127.0.0.1
UC1_GATEWAY_PORT=8000
# Authentication is ENFORCED for the cold start (AUTH_ENABLED=true), so the
# seeded account is exercised for real rather than bypassed. That makes
# AUTH_JWT_SECRET mandatory: gateway/auth.validate_auth_config() refuses to
# start on an empty or default secret. Generate one with:
#     python -c "import secrets;print(secrets.token_hex(32))"
# The script generates and writes one on first run if this is left blank.
UC1_AUTH_JWT_SECRET=

# --- Frontend (poc_1) ------------------------------------------------------
# Absolute path, or relative to this repo's parent directory.
UC1_POC1_DIR=../jnpa_poc_1
UC1_WEB_PORT=5173
