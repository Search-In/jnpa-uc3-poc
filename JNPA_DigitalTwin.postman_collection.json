       ],
       "path": [
        "v2",
        "groups",
        "nlp-marine",
        "records"
       ],
       "query": [
        {
         "key": "limit",
         "value": "25"
        },
        {
         "key": "from",
         "value": "2026-08-01",
         "disabled": true
        },
        {
         "key": "type",
         "value": "IGM",
         "disabled": true
        }
       ]
      },
      "description": "Vessel spine: profile, call information, berth request and allotment, arrival and departure.  Delivery: indexed."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200', () => pm.response.to.have.status(200));",
         "const j = pm.response.json();",
         "if (j.items.length) pm.collectionVariables.set('fileRef', j.items[0].file.fileRef);",
         "pm.test('metadata only, with a file reference', () => {",
         "  j.items.forEach(i => pm.expect(i.file.fileRef).to.be.a('string'));",
         "});"
        ]
       }
      }
     ]
