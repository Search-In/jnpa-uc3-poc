{
 "info": {
  "name": "JNPA Digital Twin \u2014 Simulated Port Data API",
  "description": "Two-step contract: request indexed JSON for a data group, then fetch any file by the reference the record carries.\n\n**Set `clientKey` to the key issued to your organisation, run `0 \u00b7 Authentication`, then anything else.**\n\nAll times are Asia/Kolkata (+05:30).",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "item": [
  {
   "name": "0 \u00b7 Authentication",
   "item": [
    {
     "name": "Exchange client key for a token",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/v2/auth/token",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "v2",
        "auth",
        "token"
       ]
      },
      "description": "Send the client key issued to your organisation. The response carries a short-lived bearer token; the collection stores it in {{accessToken}} automatically. Tokens expire \u2014 re-run this when you get a 401.",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"clientKey\": \"{{clientKey}}\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j = pm.response.json();",
         "pm.test('token issued', () => pm.expect(j.accessToken).to.be.a('string'));",
         "pm.collectionVariables.set('accessToken', j.accessToken);",
         "console.log('Token expires at', j.expiresAt);"
        ]
       }
      }
     ]
    },
    {
     "name": "Rejects an unknown client key",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/v2/auth/token",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "v2",
        "auth",
        "token"
       ]
      },
      "description": "Negative test. An unrecognised key must return 401 and must not disclose whether the key format was right.",
      "body": {
       "mode": "raw",
       "raw": "{\n  \"clientKey\": \"not-a-real-key\"\n}"
      }
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('401', () => pm.response.to.have.status(401));"
        ]
       }
      }
     ]
    }
   ]
  },
  {
