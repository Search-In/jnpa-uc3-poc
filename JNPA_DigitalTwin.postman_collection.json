       {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/v2/files/{{fileRef}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "v2",
        "files",
        "{{fileRef}}"
       ]
      },
      "description": "Second step of the contract. The reference comes from a group record; it is signed, so an altered reference is rejected. Send If-None-Match with the ETag to revalidate."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200 or 304', () => pm.expect([200,304]).to.include(pm.response.code));",
         "pm.test('has a filename', () => pm.expect(pm.response.headers.get('Content-Disposition')).to.include('filename'));"
        ]
       }
      }
     ]
    },
    {
     "name": "Rejects a tampered reference",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/v2/files/ref_TAMPERED0000000000",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "v2",
        "files",
        "ref_TAMPERED0000000000"
       ]
      },
      "description": "Negative test. References are HMAC-signed; altering one must fail closed."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('404', () => pm.response.to.have.status(404));"
        ]
       }
      }
     ]
    }
   ]
  },
  {
   "name": "4 \u00b7 Query patterns",
   "item": [
    {
     "name": "Latest first (default)",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/v2/groups/customs/records?type=IGM&limit=5",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "v2",
        "groups",
        "customs",
        "records"
       ],
       "query": [
        {
         "key": "type",
         "value": "IGM"
        },
        {
         "key": "limit",
         "value": "5"
        }
       ]
      },
      "description": "No date bounds: the most recent records come back first, as a live endpoint would."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j=pm.response.json();",
         "pm.test('newest first',()=>{const p=j.items.map(i=>i.publishedAt);",
         "  pm.expect(p).to.eql([...p].sort().reverse());});"
        ]
       }
      }
     ]
    },
    {
     "name": "Bounded by date range",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/v2/groups/customs/records?from=2026-08-01&to=2026-08-03&limit=50",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "v2",
        "groups",
        "customs",
        "records"
       ],
       "query": [
        {
         "key": "from",
         "value": "2026-08-01"
        },
        {
         "key": "to",
         "value": "2026-08-03"
        },
        {
         "key": "limit",
         "value": "50"
        }
       ]
      },
      "description": "from/to are inclusive. A bare date as the upper bound means the end of that day."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j=pm.response.json();",
         "pm.test('inside the range',()=>j.items.forEach(i=>",
         "  pm.expect(i.publishedAt.slice(0,10)).to.be.within('2026-08-01','2026-08-03')));"
        ]
       }
      }
     ]
    },
    {
     "name": "Incremental read with since",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/v2/groups/nlp-marine/records?since={{lastSeen}}&order=asc&limit=50",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "v2",
        "groups",
        "nlp-marine",
        "records"
       ],
       "query": [
        {
         "key": "since",
         "value": "{{lastSeen}}"
        },
        {
         "key": "order",
         "value": "asc"
        },
        {
         "key": "limit",
         "value": "50"
        }
       ]
      },
      "description": "since is exclusive, so you never re-read the last record. Store the last publishedAt and repeat."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j=pm.response.json();",
         "if(j.items.length) pm.collectionVariables.set('lastSeen', j.items[j.items.length-1].publishedAt);",
         "console.log('read', j.items.length, 'of', j.matched);"
        ]
       }
      }
     ]
    },
    {
     "name": "Page with the cursor",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/v2/groups/gate-documents/records?limit=25",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "v2",
        "groups",
        "gate-documents",
        "records"
       ],
       "query": [
        {
         "key": "limit",
         "value": "25"
        },
        {
         "key": "cursor",
         "value": "{{nextCursor}}",
         "disabled": true
        }
       ]
      },
      "description": "When hasMore is true, pass nextCursor back verbatim."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j=pm.response.json();",
         "if(j.nextCursor) pm.collectionVariables.set('nextCursor', j.nextCursor);"
        ]
       }
      }
     ]
    }
   ]
  }
 ],
