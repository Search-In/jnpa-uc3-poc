        "{{baseUrl}}"
       ],
       "path": []
      },
      "description": "Entry point. Lists the endpoints and the order to call them in."
     }
    },
    {
     "name": "Health",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/v2/health",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "v2",
        "health"
       ]
      },
      "description": "Liveness probe. No token required."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
        ]
       }
      }
     ]
    },
    {
     "name": "List data groups",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Authorization",
        "value": "Bearer {{accessToken}}"
       }
      ],
      "url": {
       "raw": "{{baseUrl}}/v2/groups",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "v2",
        "groups"
       ]
      },
      "description": "The 13 groups, each with how many records are available at the current simulated time."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j = pm.response.json();",
         "pm.test('groups returned', () => pm.expect(j.groups.length).to.be.above(0));",
         "pm.collectionVariables.set('simulatedNow', j.simulatedNow);"
        ]
       }
      }
     ]
    }
   ]
  },
